{
    "name": "@badag/playground",
    "private": true,
    "type": "module",
    "scripts": {
        "build:sdk": "bun run --cwd ../../packages/sdk build",
        "dev": "bun run build:sdk && bun --watch src/index.ts",
        "start": "bun run build:sdk && bun src/index.ts",
        "typecheck": "tsrs --noEmit --fast"
    },
    "dependencies": {
        "@badag/sdk": "workspace:*"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "tsrs": "^7.1.0-beta.tsrs4"
    }
}
