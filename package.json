{
    "name": "badag",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*",
        "examples/*",
        "!**/fixtures/**"
    ],
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "build:watch": "turbo watch build",
        "test": "turbo run test",
        "test:e2e": "turbo run test:e2e",
        "typecheck": "turbo run typecheck",
        "check": "ultracite check",
        "fix": "ultracite fix",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@shadcn/lint": "^0.2.5",
        "@types/bun": "^1.4.4",
        "lefthook": "^2.2.2",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "tsrs": "^7.1.0-beta.tsrs5",
        "turbo": "^2.11.13",
        "ultracite": "^8.3.1"
    },
    "packageManager": "bun@1.4.4",
    "dependencies": {
        "@rivet-dev/workflows": "^1.1.1"
    }
}
