{
    "include": ["**/*.ts", ".cloudflare/types"],
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["ES2022"],
        "types": [],

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,

        /* Linting */
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    }
}
