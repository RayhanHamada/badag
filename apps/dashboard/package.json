{
    "name": "@badag/dashboard",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "cf dev",
        "generate-routes": "tsr generate",
        "build": "cf build",
        "preview": "vite preview",
        "deploy": "cf deploy",
        "typecheck": "cf workers types && tsrs --noEmit --fast",
        "db:generate:main": "drizzle-kit generate --dialect sqlite --driver durable-sqlite --schema node_modules/@badag/db-schema/src/main-db/schema.ts --out migrations/main-db",
        "db:generate:do": "drizzle-kit generate --dialect sqlite --driver durable-sqlite --schema node_modules/@badag/db-schema/src/orchestrator-db/schema.ts --out migrations/orchestrator-db",
        "db:generate": "bun db:generate:main && bun db:generate:do",
        "db:clean-generate": "rm -rf migrations && bun db:generate:main && bun db:generate:do",
        "db:migrate": "cf d1 migrations apply 00000000000000000000000000000000 --local --persist-to .cloudflare/state --dir migrations/main-db",
        "test:e2e": "vitest run --config vitest.e2e.config.ts"
    },
    "dependencies": {
        "@badag/db-schema": "workspace:*",
        "@base-ui/react": "^1.9.0",
        "@cloudflare/dynamic-workflows": "^0.1.1",
        "@fontsource-variable/geist": "^5.3.0",
        "@orpc/contract": "^2.0.0-beta.50",
        "@orpc/json-schema": "^2.0.0-beta.50",
        "@orpc/openapi": "^2.0.0-beta.50",
        "@orpc/server": "^2.0.0-beta.50",
        "@orpc/valibot": "^2.0.0-beta.50",
        "@shadcn/react": "^0.3.1",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-devtools": "0.10.14",
        "@tanstack/react-query": "5.105.0",
        "@tanstack/react-query-devtools": "5.105.0",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.4",
        "@tanstack/redact": "^0.3.1",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.1",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.4",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.66.0",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.2.0",
        "react-resizable-panels": "^4.21.0",
        "recharts": "3.8.0",
        "shadcn": "^4.23.0",
        "shiki": "^4.6.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "valibot": "^1.5.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "rc",
        "@tanstack/devtools-vite": "0.8.6",
        "@tanstack/router-cli": "^1.168.0",
        "@types/node": "latest",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.3.0",
        "cf": "^1.0.0-rc.0",
        "drizzle-kit": "^0.31.11",
        "playwright": "^1.65.0",
        "tsrs": "^0.25.0-ts7.1.0-beta",
        "typescript": "^7.1.0-beta",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss",
            "sharp",
            "workerd"
        ]
    }
}
